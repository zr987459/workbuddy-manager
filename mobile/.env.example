# 命令行参数优先于环境变量
MOBILE_HOST=0.0.0.0
MOBILE_PORT=8796
# 核心 Manager 地址（server/main.py，默认端口 WB_MANAGER_PORT=7864）
MOBILE_CORE_URL=http://127.0.0.1:7864
# 默认版本：global（国际版）| cn
MOBILE_REALM=global
# 会话 cookie 的 Secure 标志：auto（按 https/X-Forwarded-Proto 判断）| true | false
MOBILE_SECURE_COOKIE=auto
# 额外允许的跨源（Capacitor APK 已内置 capacitor://localhost 与 https://localhost）
MOBILE_ALLOWED_ORIGINS=
# 偏好设置文件
MOBILE_DATA_DIR=./mobile/data
# 调用核心的超时（秒）；对话流不受此限
MOBILE_CORE_TIMEOUT=15
