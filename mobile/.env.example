# WorkBuddy Mobile BFF 配置（命令行参数优先于这里）
WBM_HOST=127.0.0.1
WBM_PORT=7870
# 被代理的 WorkBuddy core
WBM_CORE_URL=http://127.0.0.1:7864
# 页面挂在 /m/，接口在 /m/api/
WBM_BASE_PATH=m
# auto | true | false：BFF 会话 Cookie 是否带 Secure
WBM_SECURE_COOKIE=auto
# 仅当 BFF 前面有自己的反代（Caddy / 1Panel / Nginx）时设为 true，采信 X-Real-IP / X-Forwarded-Proto
WBM_TRUST_PROXY=false
WBM_CORE_TIMEOUT=20
# 密钥页展示的网关地址（core 的 /v1 对外地址）；留空则按「与本页同域」推断
WBM_PUBLIC_GATEWAY=
# Capacitor 壳等额外来源，逗号分隔，例如 capacitor://localhost,https://localhost
WBM_EXTRA_ORIGINS=
